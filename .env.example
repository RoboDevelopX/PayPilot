# Copy to .env and fill in. Never commit .env.
# Leave a pair blank to run that half in mock mode.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: the sandbox business account email that sends invoices
PAYPAL_INVOICER_EMAIL=
# Optional: webhook id from the same app, to verify webhook signatures
PAYPAL_WEBHOOK_ID=
PAYPILOT_BUSINESS_NAME=PayPilot Demo Studio

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Force mock modes even when keys are set (1 = on)
PAYPILOT_MOCK_PAYPAL=0
PAYPILOT_MOCK_AI=0

# Database file. Leave unset: mock mode keeps data in memory, sandbox mode uses paypal-sandbox.db
# PAYPILOT_DB=
PAYPILOT_REMINDER_CHECK_SECONDS=60
