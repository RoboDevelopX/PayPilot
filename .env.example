# Copy to .env and fill in. Never commit .env (it is git-ignored).
# PayPilot is SANDBOX ONLY: the base URL is locked to api-m.sandbox.paypal.com.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox Business account email (the merchant that sends invoices)
PAYPAL_INVOICER_EMAIL=
# Sandbox Personal account email (pays the demo invoices)
PAYPAL_PAYER_EMAIL=
# Webhook id from the same sandbox app (set after deploying, see README)
PAYPAL_WEBHOOK_ID=
BUSINESS_NAME=PayPilot Demo Studio

# LLM provider: auto (default) uses Anthropic if its key is set, else Gemini.
LLM_PROVIDER=auto

# Google Gemini, free tier (aistudio.google.com > Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried when the main model answers 503 (busy); leave empty to turn off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Anthropic, paid (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# App
DATABASE_URL=sqlite:///./paypilot.db
# 1 = seed demo data and fall back to recorded PayPal responses if the sandbox is down
DEMO_MODE=0
CHAT_RATE_LIMIT_PER_MINUTE=20
FOLLOWUP_INTERVAL_SECONDS=300
# 0 = run without the ML models (they only ever add caution; the policy still decides)
ML_ENABLED=1
# Optional: protect a public deployment with HTTP Basic auth (webhooks and /healthz stay open)
APP_USERNAME=paypilot
APP_PASSWORD=
